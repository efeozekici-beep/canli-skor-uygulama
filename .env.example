# Copy to .env.local and fill in. Keys come from https://dashboard.api-football.com
# (one API-Sports account; each API has its own free plan and daily quota).
API_FOOTBALL_KEY=
API_BASKETBALL_KEY=
API_NBA_KEY=

# Shared server cache (https://console.upstash.com -> Redis -> REST API).
# Optional locally: without these the backend caches in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" to use src/data/mockMatches.ts instead of the API.
VITE_USE_MOCK=false

# Basketball providers use mock data until set to "false".
VITE_API_BASKETBALL_MOCK=true
VITE_API_NBA_MOCK=true
