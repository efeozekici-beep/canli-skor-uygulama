{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/:provider(football|basketball|nba|footballdata|espn|euroleague)/:path*",
      "destination": "/api/proxy?provider=:provider&path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/archive?run=1",
      "schedule": "0 4 * * *"
    }
  ]
}
